# Copy this file to .env.local and fill in real values.
# See README.md "Setup" section for step-by-step instructions.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose this to the browser. Used for Storage admin operations that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database (Project Settings > Database > Connection string) ---
# Pooled connection (port 6543, pgbouncer) — used by Prisma Client at runtime.
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used by `prisma migrate`.
DIRECT_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"
# Local-dev only — a scratch database `prisma migrate dev` uses to compute schema diffs.
# Never set this in production; leave it unset there (e.g. via `prisma dev`, see README).
SHADOW_DATABASE_URL=

# --- App ---
# Absolute base URL of the deployed app, used to build absolute links (e.g. shared receipt URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Telegram bot notifications (optional — see README.md "Telegram bot" setup step) ---
# From @BotFather on Telegram after `/newbot`. Leave unset to disable the feature entirely.
TELEGRAM_BOT_TOKEN=123456:your-bot-token
TELEGRAM_BOT_USERNAME=YourBotUsername
# Shared secret Telegram echoes back on every webhook request, so you can verify it's really
# Telegram calling `/api/telegram/webhook` and not a stranger who found the URL. Optional but recommended.
TELEGRAM_WEBHOOK_SECRET=

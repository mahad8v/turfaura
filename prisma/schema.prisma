// TurfAura — Football Pitch Booking Marketplace
// See /home/zerobug110/.claude/plans/sprightly-discovering-tome.md for the architecture this implements.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum BookingStatus {
  PENDING // booked, awaiting the owner's approval (customer pays cash after playing)
  CONFIRMED // owner approved the booking
  CANCELLED // cancelled (by customer request, owner, or admin)
  EXPIRED // owner didn't approve/reject before the auto-expiry window
}

enum OwnerRole {
  OWNER
  ADMIN // reserved for a future admin portal, unused in v1
}

enum PitchType {
  FIVE_A_SIDE
  SEVEN_A_SIDE
  ELEVEN_A_SIDE
}

// ---------- Core models ----------

model Owner {
  id             String    @id @default(uuid())
  supabaseUserId String    @unique
  name           String
  email          String    @unique
  phone          String? // WhatsApp contact number customers reach the owner on
  role           OwnerRole @default(OWNER)

  // Telegram Bot notifications: chatId is set once the owner completes the
  // /start deep-link flow (see lib/telegram.ts); linkToken is the one-time
  // secret embedded in that link, cleared once it's been claimed.
  telegramChatId    String? @unique
  telegramLinkToken String? @unique

  // The turf the dashboard is currently scoped to (switched from Settings).
  // Plain id, not a relation — same "soft reference" pattern as
  // Booking.approvedBy — since an owner only ever points this at one of
  // their own pitches, enforced at the application layer.
  activePitchId String?

  pitches          Pitch[]
  platformPayments PlatformPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The platform's own monthly fee an owner pays TurfAura for listing their
// turf(s) — distinct from the cash customers pay owners for bookings
// (tracked on Booking). Tiered by how many turfs the account has at the
// time it's marked paid (see lib/platform-fee.ts): 1 turf, 2-5 turfs, or
// 6+ turfs each price differently, and the amount is locked in here rather
// than recomputed later so a paid month's record never silently changes if
// the owner adds or removes turfs afterward.
model PlatformPayment {
  id       String  @id @default(uuid())
  ownerId  String
  owner    Owner   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  year     Int
  month    Int // 1-12
  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("GMD")

  paid     Boolean   @default(false)
  paidAt   DateTime?
  // Soft reference to the admin Owner.id who marked it paid — same pattern
  // as Booking.approvedBy.
  markedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, year, month])
  @@index([ownerId])
}

model Pitch {
  id          String    @id @default(uuid())
  ownerId     String
  owner       Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  slug        String    @unique
  description String?
  address     String
  area        String    @default("") // neighbourhood/district, e.g. "Ouakam" — powers the location filter
  lat         Float
  lng         Float
  type        PitchType @default(FIVE_A_SIDE)

  photos PitchPhoto[]

  basePricePerHour Decimal @db.Decimal(10, 2)
  currency         String  @default("GMD")

  slotDurationMinutes Int    @default(60)
  openTime            String @default("10:00") // "HH:mm", pitch's local wall-clock time
  closeTime           String @default("28:00") // may exceed 24:00 for a pitch that closes after midnight — see lib/time.ts

  isActive Boolean @default(true)

  priceOverrides        PriceOverride[]
  blockedSlots          BlockedSlot[]
  recurringBlockedSlots RecurringBlockedSlot[]
  bookings              Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model PitchPhoto {
  id          String @id @default(uuid())
  pitchId     String
  pitch       Pitch  @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  storagePath String // Supabase Storage object path, not a URL — resolved via getPublicUrl at render time
  sortOrder   Int    @default(0)

  createdAt DateTime @default(now())

  @@index([pitchId])
}

// Schema-ready for day/time-based pricing; not exposed in the v1 owner UI.
model PriceOverride {
  id           String  @id @default(uuid())
  pitchId      String
  pitch        Pitch   @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  dayOfWeek    Int? // 0=Sunday..6=Saturday, null = applies every day
  startTime    String // "HH:mm"
  endTime      String // "HH:mm"
  pricePerHour Decimal @db.Decimal(10, 2)

  @@index([pitchId])
}

// Owner-set unavailability (maintenance, private hire, etc.)
model BlockedSlot {
  id        String   @id @default(uuid())
  pitchId   String
  pitch     Pitch    @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  startTime String // "HH:mm" — a null endTime means the block runs through the pitch's closing time
  endTime   String?
  reason    String?

  createdAt DateTime @default(now())

  @@index([pitchId, date])
}

// A weekly-recurring block — e.g. "every Monday 6-8pm" for a regular group's
// standing slot — as opposed to BlockedSlot's one-off specific date. Applied
// on top of BlockedSlot in availability checks, matched by day of week.
model RecurringBlockedSlot {
  id        String  @id @default(uuid())
  pitchId   String
  pitch     Pitch   @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0 = Sunday .. 6 = Saturday, matches Date#getUTCDay()
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  reason    String?

  createdAt DateTime @default(now())

  @@unique([pitchId, dayOfWeek, startTime])
  @@index([pitchId, dayOfWeek])
}

// Double-booking protection lives outside this file: a Postgres EXCLUDE
// constraint (`no_overlapping_active_bookings`, see the
// booking_overlap_exclusion migration) rejects any new active booking whose
// [startTime, endTime) range overlaps an existing active one for the same
// pitch/date — necessary because bookings can span multiple slots (e.g. a
// 2-hour booking), so two different start times can still conflict.
model Booking {
  id        String @id @default(uuid())
  reference String @unique // human-shareable code, e.g. "TA-7K4QXP"

  pitchId String
  pitch   Pitch  @relation(fields: [pitchId], references: [id], onDelete: Restrict)

  customerName  String
  customerPhone String

  date      DateTime @db.Date
  startTime String // "HH:mm", pitch's local wall-clock time
  endTime   String

  totalPrice Decimal @db.Decimal(10, 2) // paid in cash at the pitch after playing
  currency   String  @default("GMD")

  status BookingStatus @default(PENDING)

  // Auto-release safety net: if the owner hasn't approved or rejected by
  // this time, the booking flips to EXPIRED and the slot frees up.
  expiresAt DateTime?

  approvedAt DateTime?
  approvedBy String? // Owner.id who approved

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pitchId, date])
  @@index([status])
}
